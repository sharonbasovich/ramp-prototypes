{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "outDir": "server-dist",
    "rootDir": "src/engine",
    "declaration": false,
    "sourceMap": false,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/engine/**/*.ts"]
}
